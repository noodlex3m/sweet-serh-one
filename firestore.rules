rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for orders
    match /orders/{orderId} {
      allow create: if true; // anyone can place an order
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'noodlex3m@gmail.com'; // only admin
    }
    
    // Rules for products catalog
    match /products/{productId} {
      allow read: if true; // anyone can view products
      allow write: if request.auth != null && request.auth.token.email == 'noodlex3m@gmail.com'; // only admin
    }
    
    // Rules for client user profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'noodlex3m@gmail.com');
    }
  }
}
